! Tuan 5: OSPF single-area
! Dia chi tai lieu RFC 5737/3849; thay theo topology lab rieng.
configure terminal
hostname R1
router ospf 10
 router-id 1.1.1.1
 passive-interface default
 no passive-interface GigabitEthernet0/1
 network 192.0.2.0 0.0.0.255 area 0
 network 198.51.100.0 0.0.0.3 area 0
end
write memory
