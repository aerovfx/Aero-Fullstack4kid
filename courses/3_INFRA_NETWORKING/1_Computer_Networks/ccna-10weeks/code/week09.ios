! Tuan 9: ACL và port-security
! Dia chi tai lieu RFC 5737/3849; thay theo topology lab rieng.
configure terminal
hostname SW1
interface GigabitEthernet0/1
 switchport port-security
 switchport port-security maximum 2
 switchport port-security violation restrict
ip access-list extended GUEST_IN
 deny ip 192.0.2.128 0.0.0.63 192.0.2.0 0.0.0.127
 permit ip 192.0.2.128 0.0.0.63 any
end
write memory
