! Tuan 8: Chống toll fraud
! Dia chi tai lieu RFC 5737/3849; thay theo topology lab rieng.
configure terminal
hostname CUBE1
voice service voip
 ip address trusted list
  ipv4 192.0.2.0 255.255.255.0
dial-peer voice 900 voip
 destination-pattern 9T
 session target ipv4:198.51.100.10
 max-conn 5
! Chi mo route ngoai khi duoc nha cung cap uy quyen
end
write memory
