! Tuan 10: Translation và tổng hợp
! Dia chi tai lieu RFC 5737/3849; thay theo topology lab rieng.
configure terminal
hostname CME1
voice translation-rule 10
 rule 1 /^0\(.*\)/ /84\1/
voice translation-profile OUTBOUND
 translate called 10
dial-peer voice 900 voip
 translation-profile outgoing OUTBOUND
 destination-pattern 0T
 session target ipv4:198.51.100.10
end
write memory
