   "source": [
    "### 🗝️ Tuần 1: Mật Mã Cổ Điển (Caesar & Vigenère Cipher)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def caesar_encrypt(text: str, shift: int) -> str:\n",
    "    result = []\n",
    "    for char in text:\n",
    "        if char.isalpha():\n",
    "            base = ord('A') if char.isupper() else ord('a')\n",
    "            result.append(chr((ord(char) - base + shift) % 26 + base))\n",
    "        else:\n",
    "            result.append(char)\n",
    "    return ''.join(result)\n",
    "\n",
    "message = \"HELLO CRYPTOGRAPHY WORLD\"\n",
    "cipher = caesar_encrypt(message, 3)\n",
    "print(f\"Plaintext  : {message}\")\n",
    "print(f\"Ciphertext : {cipher}\")\n",
    "print(f\"Decrypted  : {caesar_encrypt(cipher, -3)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 🛡️ Tuần 2: Mã Hóa Khối Đối Xứng (AES-256-GCM)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from Crypto.Cipher import AES\n",
    "from Crypto.Random import get_random_bytes\n",
    "\n",
    "key = get_random_bytes(32) # 256-bit key\n",
    "data = b\"CONFIDENTIAL DATA ENCRYPTED WITH AES-GCM\"\n",
    "\n",
    "cipher = AES.new(key, AES.MODE_GCM)\n",
    "ciphertext, tag = cipher.encrypt_and_digest(data)\n",
    "\n",
    "print(f\"[+] Nonce (Hex)     : {cipher.nonce.hex()}\")\n",
    "print(f\"[+] Ciphertext (Hex): {ciphertext.hex()}\")\n",
    "print(f\"[+] MAC Tag (Hex)   : {tag.hex()}\")\n",
    "\n",
    "# Decrypt & Verify\n",
    "dec_cipher = AES.new(key, AES.MODE_GCM, nonce=cipher.nonce)\n",
    "decrypted = dec_cipher.decrypt_and_verify(ciphertext, tag)\n",
    "print(f\"[+] Decrypted Data  : {decrypted.decode('utf-8')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### ⚡ Tuần 3: Mã Hóa Dòng (ChaCha20-Poly1305)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from Crypto.Cipher import ChaCha20_Poly1305\n",
    "\n",
    "key = get_random_bytes(32)\n",
    "stream = b\"REAL-TIME VIDEO STREAM PACKET #1024\"\n",
    "\n",
    "cipher = ChaCha20_Poly1305.new(key=key)\n",
    "ciphertext, tag = cipher.encrypt_and_digest(stream)\n",
    "print(f\"[+] ChaCha20 Ciphertext: {ciphertext.hex()}\")\n",
    "\n",
    "# Decrypt\n",
    "dec_cipher = ChaCha20_Poly1305.new(key=key, nonce=cipher.nonce)\n",
    "decrypted = dec_cipher.decrypt_and_verify(ciphertext, tag)\n",
    "print(f\"[+] Decrypted Stream    : {decrypted.decode('utf-8')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 🔍 Tuần 4: Hàm Băm Mật Mã (SHA-256 & HMAC)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import hashlib, hmac\n",
    "\n",
    "message = b\"PAYLOAD FOR INTEGRITY CHECK\"\n",
    "secret_key = b\"HMAC_SECRET_KEY_2026\"\n",
    "\n",
    "sha256_hash = hashlib.sha256(message).hexdigest()\n",
    "hmac_sig = hmac.new(secret_key, message, hashlib.sha256).hexdigest()\n",
    "\n",
    "print(f\"[+] SHA-256 Hash  : {sha256_hash}\")\n",
    "print(f"[+] HMAC Signature: {hmac_sig}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 🧮 Tuần 5: Thuật Toán Mã Hóa Bất Đối Xứng RSA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# RSA Math from Scratch\n",
    "p, q = 61, 53\n",
    "n = p * q\n",
    "phi = (p - 1) * (q - 1)\n",
    "e = 65537\n",
    "\n",
    "def mod_inverse(e, phi):\n",
    "    def ext_gcd(a, b):\n",
    "        if a == 0: return b, 0, 1\n",
    "        g, x1, y1 = ext_gcd(b % a, a)\n",
    "        return g, y1 - (b // a) * x1, x1\n",
    "    return ext_gcd(e, phi)[1] % phi\n",
    "\n",
    "d = mod_inverse(e, phi)\n",
    "msg = 42\n",
    "ciphertext = pow(msg, e, n)\n",
    "decrypted = pow(ciphertext, d, n)\n",
    "\n",
    "print(f\"[+] RSA Public Key (e={e}, n={n})\")\n",
    "print(f"[+] RSA Private Key (d={d}, n={n})\")\n",
    "print(f\"[+] Original Message : {msg}\")\n",
    "print(f\"[+] Encrypted        : {ciphertext}\")\n",
    "print(f"[+] Decrypted        : {decrypted}\")"
   ]
  },
