   "source": [
    "### 🔑 Tuần 8: Băm Mật Khẩu Argon2id & Salt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from argon2 import PasswordHasher\n",
    "\n",
    "ph = PasswordHasher(time_cost=2, memory_cost=65536, parallelism=2)\n",
    "pw = \"MySecurePassword@2026\"\n",
    "hashed = ph.hash(pw)\n",
    "\n",
    "print(f\"[+] Argon2id Hash: {hashed}\")\n",
    "print(f\"[+] Verify Correct: {ph.verify(hashed, pw)}\")"
   ]
