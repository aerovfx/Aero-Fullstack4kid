   "source": [
    "### 🌐 Tuần 6: Trao Đổi Khóa Elliptic Curve ECDH (Curve25519)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from cryptography.hazmat.primitives.asymmetric import x25519\n",
    "from cryptography.hazmat.primitives.kdf.hkdf import HKDF\n",
    "from cryptography.hazmat.primitives import hashes\n",
    "\n",
    "alice_priv = x25519.X25519PrivateKey.generate()\n",
    "bob_priv = x25519.X25519PrivateKey.generate()\n",
    "\n",
    "alice_shared = HKDF(hashes.SHA256(), 32, None, b\"info\").derive(alice_priv.exchange(bob_priv.public_key()))\n",
    "bob_shared = HKDF(hashes.SHA256(), 32, None, b\"info\").derive(bob_priv.exchange(alice_priv.public_key()))\n",
    "\n",
    "print(f\"[+] Alice Shared Key: {alice_shared.hex()}\")\n",
    "print(f\"[+] Bob Shared Key  : {bob_shared.hex()}\")\n",
    "print(f\"[+] Key Agreement Match: {alice_shared == bob_shared}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### ✍️ Tuần 7: Chữ Ký Số Ed25519"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from cryptography.hazmat.primitives.asymmetric import ed25519\n",
    "\n",
    "priv_key = ed25519.Ed25519PrivateKey.generate()\n",
    "pub_key = priv_key.public_key()\n",
    "doc = b\"OFFICIAL CONTRACT AGREEMENT 2026\"\n",
    "\n",
    "sig = priv_key.sign(doc)\n",
    "print(f\"[+] Signature (Hex): {sig.hex()}\")\n",
    "try:\n",
    "    pub_key.verify(sig, doc)\n",
    "    print(\"[✅ VERIFIED] Signature is Valid!\")\n",
    "except Exception:\n",
    "    print(\"[-] Invalid Signature!\")"
   ]
  },
  {
   "cell_type": "markdown",
