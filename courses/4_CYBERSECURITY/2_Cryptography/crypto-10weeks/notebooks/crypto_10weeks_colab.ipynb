    "### 🌌 Tuần 9: Schnorr Zero-Knowledge Proof (ZKP) Simulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import random\n",
    "p, g = 2695139, 2\n",
    "x = 123456 # Secret\n",
    "y = pow(g, x, p) # Public Key\n",
    "\n",
    "r = random.randint(1, p - 2)\n",
    "t = pow(g, r, p) # Commitment\n",
    "c = random.randint(1, 1000) # Challenge\n",
    "s = r + c * x # Response\n",
    "\n",
    "lhs = pow(g, s, p)\n",
    "rhs = (t * pow(y, c, p)) % p\n",
    "print(f\"[+] ZKP Verification Success: {lhs == rhs}\")"
   ]
  },
