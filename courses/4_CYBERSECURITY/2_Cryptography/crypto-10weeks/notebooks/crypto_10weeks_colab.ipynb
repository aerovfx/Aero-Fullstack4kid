    "### 🚀 Tuần 10: Capstone Project - Engine Chat Mã Hóa Đầu-Cuối (E2EE Messenger)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from cryptography.hazmat.primitives.ciphers.aead import AESGCM\n",
    "import os\n",
    "\n",
    "# Combined E2EE Protocol Simulation\n",
    "alice_eph = x25519.X25519PrivateKey.generate()\n",
    "bob_eph = x25519.X25519PrivateKey.generate()\n",
    "\n",
    "session_key = HKDF(hashes.SHA256(), 32, b\"salt\", b\"e2ee\").derive(alice_eph.exchange(bob_eph.public_key()))\n",
    "aesgcm = AESGCM(session_key)\n",
    "nonce = os.urandom(12)\n",
    "\n",
    "secret_msg = b\"CAPSTONE E2EE MESSENGER PAYLOAD\"\n",
    "ciphertext = aesgcm.encrypt(nonce, secret_msg, None)\n",
    "decrypted = aesgcm.decrypt(nonce, ciphertext, None)\n",
    "\n",
    "print(f\"[+] E2EE Encrypted Payload : {ciphertext.hex()}\")\n",
    "print(f\"[+] E2EE Decrypted Payload : {decrypted.decode('utf-8')}\")"
   ]
